# SQLite database location, relative to the project root unless absolute.
LPFLANGE_DB_PATH=data/lpflange.sqlite

# Used only when creating the first and only administrator.
LPFLANGE_ADMIN_USERNAME=admin
LPFLANGE_ADMIN_PASSWORD=

# Replace with a long random value before deployment. Required in production.
LPFLANGE_SESSION_SECRET=replace-with-a-long-random-production-secret
